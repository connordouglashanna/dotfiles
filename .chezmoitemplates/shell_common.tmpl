# --- Shared Environment Variables ---
export EDITOR="vim"
export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  <-- Removed for lazy loading

# Add local bin to PATH
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$PATH:$HOME/.local/bin"
fi

# --- Shared Aliases ---
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# --- OS Specific LS Colors ---
# `vivid generate` costs ~100ms because it spawns a process; cache its output
# and regenerate only when the vivid binary is newer than the cache.
# Read back with the `read` builtin, NOT $(cat ...) - cat would spawn the very
# process we are trying to avoid.
{{ if eq .chezmoi.os "darwin" -}}
if command -v vivid &>/dev/null; then
  _lsc_cache="$HOME/.config/ls_colors"
  _lsc_bin="$(command -v vivid)"
  if [ ! -s "$_lsc_cache" ] || [ "$_lsc_bin" -nt "$_lsc_cache" ]; then
      vivid generate catppuccin-mocha > "$_lsc_cache" 2>/dev/null
  fi
  IFS= read -r LS_COLORS < "$_lsc_cache" 2>/dev/null || :
  export LS_COLORS
  unset _lsc_cache _lsc_bin
  if command -v gls &>/dev/null; then
    alias ls='gls --color=auto'
  else
    alias ls='ls --color=auto'
  fi
else
  alias ls='ls -G'
fi
{{ else -}}
if command -v vivid &>/dev/null; then
  _lsc_cache="$HOME/.config/ls_colors"
  _lsc_bin="$(command -v vivid)"
  if [ ! -s "$_lsc_cache" ] || [ "$_lsc_bin" -nt "$_lsc_cache" ]; then
      vivid generate catppuccin-mocha > "$_lsc_cache" 2>/dev/null
  fi
  IFS= read -r LS_COLORS < "$_lsc_cache" 2>/dev/null || :
  export LS_COLORS
  unset _lsc_cache _lsc_bin
  alias ls='ls --color=auto'
elif [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
else
    alias ls='ls --color=auto'
fi
{{- end }}

# --- Tool Initializations ---

# Fastfetch (Optimized via ~/.config/fastfetch/config.jsonc)
if command -v fastfetch &>/dev/null; then
    fastfetch
fi

# Lazy load NVM
export NVM_DIR="$HOME/.nvm"
function nvm {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    nvm "$@"
}
function node {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    node "$@"
}
function npm {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    npm "$@"
}
function npx {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    npx "$@"
}

# Starship (pre-generated init, self-healing).
# The cached init embeds an ABSOLUTE path to the starship binary, so a package
# manager update that moves or unshims it leaves the cache pointing at a dead
# path - producing an error on every prompt. Two guards:
#   1. Check the binary exists FIRST; no starship => source nothing, stay quiet.
#   2. If the binary is newer than the cache, regenerate the cache.
if command -v starship >/dev/null 2>&1; then
    _ss_cache="$HOME/.config/starship.{{ .shell }}"
    _ss_bin="$(command -v starship)"
    if [ ! -s "$_ss_cache" ] || [ "$_ss_bin" -nt "$_ss_cache" ]; then
        starship init {{ .shell }} --print-full-init > "$_ss_cache" 2>/dev/null
    fi
    [ -s "$_ss_cache" ] && . "$_ss_cache"
    unset _ss_cache _ss_bin
fi

# Zoxide (Optimized: sourcing pre-generated init)
if [ -f "$HOME/.config/zoxide.{{ .shell }}" ]; then
    . "$HOME/.config/zoxide.{{ .shell }}"
elif command -v zoxide &>/dev/null; then
    eval "$(zoxide init {{ .shell }})"
fi

# FZF Settings
if command -v fzf &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi

# --- Custom Shell Specific logic inside common template if needed ---
{{ if eq .shell "zsh" -}}
# Zsh specific fuzzy completion using fd
_fzf_compgen_path() {
  fd --hidden --follow --exclude ".git" . "$1"
}
_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" . "$1"
}
{{- end }}
